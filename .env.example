# ─── Supabase ───────────────────────────────────────────────────────────────────
# Tạo project tại https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# URL của app khi deploy (dùng cho redirect sau đăng nhập OTP)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
# Service role key để admin đọc/ghi dữ liệu vượt RLS (Settings → API → service_role)
# KHÔNG đặt trong NEXT_PUBLIC_ — chỉ dùng server-side
SUPABASE_SERVICE_ROLE_KEY=""

# ─── VietQR thanh toán thủ công ─────────────────────────────────────────────────
# Thông tin tài khoản ngân hàng để nhận thanh toán Pro
# bankId: mã ngân hàng VietQR (xem tại https://api.vietqr.io/v2/banks)
VIETQR_BANK_ID="vietcombank"
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME=""
# Giá gói Pro (VND), mặc định 990000
PRO_PRICE_VND="990000"

# ─── Email nhắc hạn (tính năng Pro) ─────────────────────────────────────────────
# Tạo API key tại https://resend.com → API Keys
RESEND_API_KEY=""
# Domain đã xác minh trong Resend
RESEND_FROM_DOMAIN="noreply.example.com"
# Secret để xác thực cron job từ Vercel (tạo ngẫu nhiên >= 32 ký tự)
CRON_SECRET="doi-thanh-mot-chuoi-ngau-nhien-it-nhat-32-ky-tu"

# ─── Admin panel ────────────────────────────────────────────────────────────────
# Tạo mật khẩu mới: npm run hash-password -- "mat-khau-cua-ban"
# rồi dán chuỗi hash in ra vào ADMIN_PASSWORD_HASH bên dưới.
# QUAN TRỌNG: thêm dấu \ trước mỗi dấu $ trong chuỗi hash (vd \$2b\$10\$...)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
SESSION_SECRET="doi-thanh-mot-chuoi-ngau-nhien-it-nhat-32-ky-tu"

# ─── Hiển thị nội dung draft (chỉ dùng khi test) ────────────────────────────────
# Đặt true để xem nội dung status=draft trên trang kết quả
# KHÔNG bật trên production
NEXT_PUBLIC_CONTENT_PREVIEW="false"
