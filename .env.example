# ─── Supabase (Stage 2) ────────────────────────────────────────────────────────
# Tạo project tại https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# URL của app khi deploy (dùng cho redirect sau đăng nhập OTP)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# ─── Prisma / Postgres (dùng cho admin, không cần khi chỉ dùng Stage 1/2) ─────
# Chuỗi kết nối Postgres (Neon). Khi deploy qua Vercel, chọn Storage → Postgres
# thì các biến DATABASE_URL / DATABASE_URL_UNPOOLED sẽ được tự động điền.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Tự động có khi kết nối Vercel Blob (Storage → Blob) — không cần tự điền.
BLOB_READ_WRITE_TOKEN=""

# ─── Stripe payments (Stage 5) ─────────────────────────────────────────────────
# Tạo account tại https://stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=""
# Dùng cho client-side Stripe.js (prefix NEXT_PUBLIC_ để expose ra browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook secret: Stripe Dashboard → Webhooks → Add endpoint → /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""
# Price ID cho gói Pro: Stripe → Product Catalog → tạo recurring product → copy price ID
STRIPE_PRICE_ID=""

# ─── Email reminders (Stage 4) ─────────────────────────────────────────────────
# Tạo API key tại https://resend.com → API Keys
RESEND_API_KEY=""
# Domain đã xác minh trong Resend (dùng để gửi từ địa chỉ nhac-han@<domain>)
RESEND_FROM_DOMAIN="noreply.example.com"
# Secret để xác thực cron job từ Vercel (tạo ngẫu nhiên >= 32 ký tự)
CRON_SECRET="doi-thanh-mot-chuoi-ngau-nhien-it-nhat-32-ky-tu"
# Service role key để cron đọc all users (Settings → API → service_role)
# KHÔNG đặt trong NEXT_PUBLIC_ — chỉ dùng server-side
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Admin panel ────────────────────────────────────────────────────────────────
# Admin panel
# Tạo mật khẩu mới: npm run hash-password -- "mat-khau-cua-ban"
# rồi dán chuỗi hash in ra vào ADMIN_PASSWORD_HASH bên dưới.
# QUAN TRỌNG: thêm dấu \ trước mỗi dấu $ trong chuỗi hash (vd \$2b\$10\$...)
# để Next.js không hiểu nhầm $2b/$10 là biến môi trường khác.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
SESSION_SECRET="doi-thanh-mot-chuoi-ngau-nhien-it-nhat-32-ky-tu"
